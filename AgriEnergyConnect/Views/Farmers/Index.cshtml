@model IEnumerable<AgriEnergyConnect.Models.Farmer>

<h2>Farmers</h2>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Products</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var farmer in Model)
        {
            <tr>
                <td>@farmer.Name</td>
                <td>@farmer.Location</td>
                <td>
                    @foreach (var p in farmer.Products)
                    {
                        <div>@p.Name (@p.Category)</div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
