@model AgriEnergyConnect.Models.Farmer

@{
    ViewData["Title"] = "Delete Farmer";
}

<div class="card shadow-sm rounded-4 border-0 p-4 text-center">
    <h4 class="text-danger fw-bold mb-4">Delete Farmer</h4>

    <p class="mb-4">Are you sure you want to delete <strong>@Model.Name</strong> from the system?</p>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </div>
    </form>
</div>
