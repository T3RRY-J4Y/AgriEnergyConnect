@using Microsoft.AspNetCore.Identity
@inject SignInManager<AgriEnergyConnect.Models.ApplicationUser> SignInManager
@inject UserManager<AgriEnergyConnect.Models.ApplicationUser> UserManager

@{
    var isLoggedIn = User.Identity?.IsAuthenticated ?? false;
    var userRole = isLoggedIn
        ? (User.IsInRole("Employee") ? "Employee" : "Farmer")
        : string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Agri-Energy Connect</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Background Image with Parallax & Overlay -->
    <div class="bg-image"></div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-white" asp-controller="Home" asp-action="Index">
                🌱 AgriEnergyConnect
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (isLoggedIn)
                    {
                        @if (userRole == "Employee")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Farmers" asp-action="Index">Farmers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Products" asp-action="AllProducts">Products</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Products" asp-action="MyProducts">My Products</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Products" asp-action="Create">Add Product</a>
                            </li>
                        }

                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm ms-2">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mt-4 mb-5 flex-fill">
        <div class="card shadow-sm rounded-4 p-4" style="background-color: rgba(255,255,255,0.9);">
            <h2 class="mb-4 text-success fw-bold">@ViewData["Title"]</h2>
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-success text-white text-center py-3 mt-auto">
        <small>&copy; @DateTime.Now.Year - AgriEnergyConnect | Built for Sustainable Agriculture 🌾</small>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

    <style>
        /* Full-page background with parallax & overlay */
        .bg-image {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('/images/background.jpg') no-repeat center center;
            background-size: cover;
            z-index: -1; /* behind all content */
            filter: brightness(0.7); /* subtle dark overlay for readability */
            background-attachment: fixed; /* parallax effect */
        }
    </style>
</body>
</html>
