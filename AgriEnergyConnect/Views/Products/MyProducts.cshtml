@model IEnumerable<AgriEnergyConnect.Models.Product>

@{
    ViewData["Title"] = "My Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold text-success">Your Registered Products</h4>
    <a asp-action="Create" class="btn btn-success shadow-sm">+ Add Product</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center shadow-sm">
        <strong>No products found.</strong> Add your first product to get started 🌿
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle shadow-sm">
            <thead class="table-success">
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Production Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.ProductionDate.ToShortDateString()</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-success btn-sm me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
